rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ariful.amar@gmail.com';
    }
    function myProfile() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }
    function isApprovedTeacher() {
      return signedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && myProfile().role == 'teacher'
        && myProfile().status == 'approved';
    }
    function ownsForm(formId) {
      return isApprovedTeacher()
        && exists(/databases/$(db)/documents/forms/$(formId))
        && get(/databases/$(db)/documents/forms/$(formId)).data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'teacher'
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow update: if isSuperAdmin()
        || (signedIn() && request.auth.uid == uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.role == 'teacher')
        || (signedIn() && request.auth.uid == uid
          && resource.data.status == 'approved'
          && request.resource.data.status == resource.data.status
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','subject','school','updatedAt','photoURL']));
      allow delete: if isSuperAdmin();
    }

    match /forms/{formId} {
      allow read: if signedIn() && (resource.data.open == true
        || isSuperAdmin()
        || (isApprovedTeacher() && resource.data.ownerUid == request.auth.uid));
      allow create: if isSuperAdmin()
        || (isApprovedTeacher() && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isSuperAdmin()
        || (isApprovedTeacher() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid);
    }

    match /keys/{formId} {
      allow read, write: if isSuperAdmin() || ownsForm(formId);
    }

    match /responses/{responseId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.formId is string
        && exists(/databases/$(db)/documents/forms/$(request.resource.data.formId))
        && get(/databases/$(db)/documents/forms/$(request.resource.data.formId)).data.open == true;
      allow read, delete: if isSuperAdmin()
        || (resource.data.formId is string && ownsForm(resource.data.formId));
      allow update: if isSuperAdmin()
        || (resource.data.formId is string && ownsForm(resource.data.formId));
    }
  }
}